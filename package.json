{
  "name": "desafio-automacao-api",
  "version": "1.0.0",
  "description": "Automação de testes da API de usuários (ServeRest) com Playwright e TypeScript",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:limite-taxa": "playwright test --config=playwright.limite-taxa.config.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
